{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lobster-trap/Kickama/schemas/build-diagnostic.schema.json",
  "title": "Build Diagnostic Metadata",
  "description": "Schema for build diagnostic metadata JSON files generated by the build system",
  "type": "object",
  "properties": {
    "generated_at": {
      "description": "ISO 8601 timestamp when the diagnostic was generated",
      "type": "string",
      "format": "date-time",
      "examples": ["2026-06-16T15:23:47.496569+00:00"]
    },
    "commit": {
      "description": "Git commit SHA (may be all zeros for stub diagnostics)",
      "type": "string",
      "minLength": 8,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{8,40}$",
      "examples": ["00000000", "3774a0c821d206132ed2d89bfc820929493a7635"]
    },
    "diagnostic_logd": {
      "description": "Path to the encrypted diagnostic log file",
      "type": "string",
      "pattern": "^diagnostic/build-[0-9a-f]{8}.logd$",
      "examples": ["diagnostic/build-00000000.logd"]
    },
    "diagnostic_logd_error": {
      "description": "Error message if the logd generation failed, null otherwise",
      "type": ["string", "null"],
      "default": null
    },
    "chunked": {
      "description": "Whether the diagnostic was split into chunks",
      "type": "boolean",
      "default": false
    },
    "chunk_size_bytes": {
      "description": "Size of each chunk in bytes when chunked is true",
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "password": {
      "description": "Password used to encrypt the logd file",
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{16,}$",
      "examples": ["4c7df15ab09fbb066197"]
    },
    "decrypt_command": {
      "description": "Command template to decrypt the logd file",
      "type": "string",
      "examples": ["encryptly unpack diagnostic/build-00000000.logd <outdir> --password 4c7df15ab09fbb066197"]
    },
    "total_modules": {
      "description": "Total number of module entries",
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "description": "Number of modules that passed",
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "description": "Number of modules that failed",
      "type": "integer",
      "minimum": 0
    },
    "modules": {
      "description": "List of module build results",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Module name",
            "type": "string",
            "examples": ["frailbox", "backend", "frontend", "market"]
          },
          "status": {
            "description": "Build status",
            "type": "string",
            "enum": ["PASS", "FAIL", "SKIP", "WARN"]
          },
          "elapsed_seconds": {
            "description": "Build duration in seconds",
            "type": "number",
            "minimum": 0
          },
          "artifact": {
            "description": "Path to the build artifact, null if none produced",
            "type": ["string", "null"],
            "default": null
          },
          "output": {
            "description": "Human-readable build output or error message",
            "type": "string"
          }
        },
        "required": ["name", "status", "elapsed_seconds", "output"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "pr_note": {
      "description": "Standard note for PR submissions",
      "type": "string"
    }
  },
  "required": [
    "generated_at", "commit", "diagnostic_logd", "password",
    "total_modules", "passed", "failed", "modules"
  ],
  "additionalProperties": false
}
